# vLLM Server URL (default: http://localhost:8000/v1)
VLLM_BASE_URL=http://localhost:8000/v1

# vLLM API Key — leave as "EMPTY" if auth is not enabled on vLLM
VLLM_API_KEY=EMPTY

# Model name (must match the model loaded in vLLM)
AI_MODEL=Phonsiri/Gemma-4-E4B-it-PARL

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:5173

# System Prompt
SYSTEM_PROMPT=You are a helpful AI assistant. You can speak both Thai and English fluently. Be friendly, helpful, and concise. Format your responses using markdown when appropriate.

# Max tokens per response
MAX_TOKENS=2048

# Hugging Face Token (needed for gated models like Gemma-4)
HF_TOKEN=your_huggingface_token_here
